import streamlit as st
import pandas as pd
import plotly.express as px

# ==========================================
# 1. KONFIGURASI HALAMAN
# ==========================================
st.set_page_config(
    page_title="Dashboard Energi Daerah",
    page_icon="⚡",
    layout="wide"
)

# ==========================================
# 2. JUDUL DASHBOARD
# ==========================================
st.title("Dashboard Prediksi Konsumsi Energi Daerah")
st.caption(
    "Visualisasi Data dan Prediksi untuk "
    "Mendukung Keputusan Publik"
)
st.markdown("---")

# ==========================================
# 3. MEMBUAT DATASET
# ==========================================
data = {
    "Tahun": [
        2020, 2021, 2022, 2023,
        2024, 2025, 2026, 2027
    ],
    "Konsumsi_Energi_MW": [
        120, 135, 150, 170,
        195, 220, 245, 275
    ],
    "Status": [
        "Historis",
        "Historis",
        "Historis",
        "Historis",
        "Historis",
        "Prediksi",
        "Prediksi",
        "Prediksi"
    ]
}
df = pd.DataFrame(data)

# ==========================================
# 4. FILTER INTERAKTIF
# ==========================================
st.sidebar.header("Filter Dashboard")

pilihan_status = st.sidebar.multiselect(
    "Pilih Status Data:",
    options=df["Status"].unique(),
    default=df["Status"].unique()
)

pilihan_tahun = st.sidebar.slider(
    "Pilih Rentang Tahun:",
    min_value=int(df["Tahun"].min()),
    max_value=int(df["Tahun"].max()),
    value=(
        int(df["Tahun"].min()),
        int(df["Tahun"].max())
    )
)

# Memproses filter
df_filter = df[
    (df["Status"].isin(pilihan_status)) &
    (df["Tahun"] >= pilihan_tahun[0]) &
    (df["Tahun"] <= pilihan_tahun[1])
]

# ==========================================
# 5. MENAMPILKAN ANGKA RINGKASAN
# ==========================================
st.subheader("Ringkasan Data")
kolom1, kolom2, kolom3 = st.columns(3)

if not df_filter.empty:
    nilai_tertinggi = df_filter[
        "Konsumsi_Energi_MW"
    ].max()
    nilai_terendah = df_filter[
        "Konsumsi_Energi_MW"
    ].min()
    rata_rata = df_filter[
        "Konsumsi_Energi_MW"
    ].mean()

    kolom1.metric(
        "Konsumsi Tertinggi",
        f"{nilai_tertinggi} MW"
    )
    kolom2.metric(
        "Konsumsi Terendah",
        f"{nilai_terendah} MW"
    )
    kolom3.metric(
        "Rata-rata Konsumsi",
        f"{rata_rata:.2f} MW"
    )
else:
    st.warning(
        "Tidak ada data yang sesuai dengan filter."
    )

st.markdown("---")

# ==========================================
# 6. LINE CHART (GRAFIK GARIS)
# ==========================================
st.subheader("Grafik Tren Konsumsi Energi")

if not df_filter.empty:
